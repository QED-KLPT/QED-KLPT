{
  "name": "kindergarten-learning-progression-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end test automation for KLPT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report artifacts/html-report",
    "codegen": "node utils/codegen.js"
  },
  "keywords": [
    "playwright",
    "klpt",
    "e2e",
    "automation"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}

# A local .env file is OPTIONAL for this project.
#
# The suite targets the KLPT Test environment by default (defined centrally in
# playwright.config.ts as KLPT_TEST_URL). Copy this file to ".env" only if you
# need to override that default, e.g. to point the suite at a different KLPT
# environment without editing playwright.config.ts.
#
# NOTE: KLPT_PASSKEY is intentionally NOT read from here. It is a standard,
# shared application passkey used by everyone accessing the KLPT Test
# environment (not a per-user secret), so it is defined once as a plain
# constant in test-data/klpt.constants.ts and reused from there.

# Optional override for the KLPT base URL.
KLPT_BASE_URL=https://example-klpt-url
